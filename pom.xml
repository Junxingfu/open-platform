<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 父 POM：统一管理 Spring / Jackson / Tomcat / 测试等依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.crcit</groupId>
    <artifactId>open-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>open-platform</name>
    <description>开放平台：企业级授权、接口鉴权、防重放、内部网关调用</description>

    <properties>
        <!-- 必须使用 JDK 17：Spring Boot 3.x 的最低要求，也是本项目编译目标 -->
        <java.version>17</java.version>
        <!-- 源码/资源统一 UTF-8，避免中文注释和响应乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Nimbus JOSE + JWT：负责 RS256 签名与校验 -->
        <nimbus.version>9.25.6</nimbus.version>
    </properties>

    <dependencies>
        <!-- Web + 内嵌 Tomcat + Jackson：提供 REST 接口与 JSON 序列化 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（Jakarta Validation + Hibernate Validator）：
             EnterpriseController 的 @Valid/@NotBlank 依赖它。
             如果 IDEA 报“程序包 jakarta.validation 不存在”，说明该依赖没下载成功。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator：暴露 /actuator/health 等运维端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Cache 抽象 + Caffeine 本地缓存实现（当前业务暂未使用 @Cacheable，保留扩展能力） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Redis starter：为后续把防重放/缓存替换为 Redis 预留。
             当前没有实际连接 Redis，application.yml 中已关闭 Redis 健康检查。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JWT 签发与校验（RS256） -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus.version}</version>
        </dependency>

        <!-- 测试：JUnit 5、MockMvc、AssertJ 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 生成固定名称 target/open-platform.jar，方便脚本和文档引用 -->
        <finalName>open-platform</finalName>
        <plugins>
            <!-- repackage：把依赖打进可执行 jar，java -jar 即可启动 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
